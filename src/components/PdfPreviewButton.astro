---
import { printablePdfUrl, type Resource } from '../lib/resource';
interface Props { resource: Resource; class?: string; }
const { resource, class: className = 'button' } = Astro.props;
---
<button type="button" class={className} data-pdf-preview data-pdf-url={`/pdfs/${resource.slug}.pdf`} data-pdf-download={printablePdfUrl(resource)} data-resource-title={resource.title} data-resource-page={`/resources/${resource.slug}/`} aria-haspopup="dialog" aria-controls="pdf-preview">
  <span>Preview Printable PDF<span class="sr-only"> — {resource.title}</span></span>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></svg>
</button>
