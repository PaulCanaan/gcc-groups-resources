<dialog id="pdf-preview" class="pdf-preview" aria-labelledby="pdf-preview-title" aria-describedby="pdf-preview-description">
  <header class="pdf-preview-header">
    <div><p class="eyebrow">Printable PDF preview</p><h2 id="pdf-preview-title"></h2></div>
    <button type="button" class="pdf-preview-close" aria-label="Close PDF preview" autofocus><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg></button>
  </header>
  <p id="pdf-preview-description" class="pdf-preview-description">Review the printable edition below. Download it when you’re ready.</p>
  <div class="pdf-preview-content"><p data-preview-status role="status">Loading PDF preview…</p><canvas role="img" aria-label="PDF page preview" hidden></canvas></div>
  <nav class="pdf-preview-pages" aria-label="PDF pages"><button type="button" data-preview-previous disabled aria-label="Previous PDF page">←</button><span data-preview-page aria-live="polite"></span><button type="button" data-preview-next disabled aria-label="Next PDF page">→</button></nav>
  <footer class="pdf-preview-footer"><a class="text-link" data-preview-reading>Read full resource</a><a class="button" data-preview-download download>Download Printable PDF <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5" /></svg></a></footer>
</dialog>
<script>
  import type { PDFDocumentLoadingTask, PDFDocumentProxy, RenderTask } from 'pdfjs-dist';
  import workerUrl from 'pdfjs-dist/build/pdf.worker.min.mjs?url';

  const dialog = document.querySelector<HTMLDialogElement>('#pdf-preview')!;
  const canvas = dialog.querySelector<HTMLCanvasElement>('canvas')!;
  const scroll = dialog.querySelector<HTMLDivElement>('.pdf-preview-content')!;
  const status = dialog.querySelector<HTMLParagraphElement>('[data-preview-status]')!;
  const heading = dialog.querySelector<HTMLHeadingElement>('#pdf-preview-title')!;
  const download = dialog.querySelector<HTMLAnchorElement>('[data-preview-download]')!;
  const reading = dialog.querySelector<HTMLAnchorElement>('[data-preview-reading]')!;
  const previous = dialog.querySelector<HTMLButtonElement>('[data-preview-previous]')!;
  const next = dialog.querySelector<HTMLButtonElement>('[data-preview-next]')!;
  const pageLabel = dialog.querySelector<HTMLSpanElement>('[data-preview-page]')!;
  let opener: HTMLButtonElement | undefined;
  let loadingTask: PDFDocumentLoadingTask | undefined;
  let pdf: PDFDocumentProxy | undefined;
  let renderTask: RenderTask | undefined;
  let request = 0;
  let pageNumber = 1;

  function showError(error: unknown) {
    console.error('Unable to load PDF preview', error);
    canvas.hidden = true;
    status.hidden = false;
    status.textContent = 'The preview couldn’t load. You can read the full resource or download the PDF below.';
    previous.disabled = next.disabled = true;
  }

  async function renderPage(currentRequest: number) {
    if (!pdf) return;
    previous.disabled = next.disabled = true;
    try {
      const page = await pdf.getPage(pageNumber);
      if (currentRequest !== request) return;
      const original = page.getViewport({ scale: 1 });
      const viewport = page.getViewport({ scale: (scroll.clientWidth - 32) / original.width });
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(viewport.width * pixelRatio);
      canvas.height = Math.floor(viewport.height * pixelRatio);
      canvas.style.width = `${viewport.width}px`;
      canvas.style.height = 'auto';
      renderTask = page.render({ canvas, canvasContext: canvas.getContext('2d')!, viewport, transform: [pixelRatio, 0, 0, pixelRatio, 0, 0] });
      await renderTask.promise;
      if (currentRequest !== request) return;
      canvas.hidden = false;
      status.hidden = true;
      canvas.setAttribute('aria-label', `Page ${pageNumber} of ${pdf!.numPages}: ${heading.textContent}`);
      pageLabel.textContent = `Page ${pageNumber} of ${pdf!.numPages}`;
      previous.disabled = pageNumber === 1;
      next.disabled = pageNumber === pdf!.numPages;
      scroll.scrollTop = 0;
    } catch (error) {
      if (currentRequest === request) showError(error);
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-pdf-preview]')) {
    button.addEventListener('click', async () => {
      opener = button;
      const currentRequest = ++request;
      heading.textContent = button.dataset.resourceTitle!;
      download.href = button.dataset.pdfDownload!;
      reading.href = button.dataset.resourcePage!;
      canvas.hidden = true;
      status.hidden = false;
      status.textContent = 'Loading PDF preview…';
      pageLabel.textContent = '';
      previous.disabled = next.disabled = true;
      dialog.showModal();
      try {
        const { getDocument, GlobalWorkerOptions } = await import('pdfjs-dist');
        if (currentRequest !== request) return;
        GlobalWorkerOptions.workerSrc = workerUrl;
        const task = getDocument({ url: button.dataset.pdfUrl! });
        loadingTask = task;
        const document = await task.promise;
        if (currentRequest !== request) return;
        pdf = document;
        pageNumber = 1;
        await renderPage(currentRequest);
      } catch (error) {
        if (currentRequest === request) showError(error);
      }
    });
  }
  previous.addEventListener('click', () => { pageNumber--; void renderPage(request); });
  next.addEventListener('click', () => { pageNumber++; void renderPage(request); });
  dialog.querySelector<HTMLButtonElement>('.pdf-preview-close')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('keydown', event => {
    if (event.key !== 'Tab') return;
    const controls = [...dialog.querySelectorAll<HTMLElement>('button:not([disabled]), a[href]')];
    const first = controls[0];
    const last = controls[controls.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
  dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => {
    request++;
    renderTask?.cancel();
    renderTask = undefined;
    void loadingTask?.destroy().catch(() => {});
    loadingTask = undefined;
    pdf = undefined;
    opener?.focus();
  });
</script>
