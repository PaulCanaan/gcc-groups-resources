---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { categories } from '../lib/resource';
import { resources } from '../lib/resources';
const all = await resources;
const available = categories.filter(category => all.some(resource => resource.category === category.id));
---
<Layout>
  <section class="hero wrap" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <p class="eyebrow breadcrumb"><a href="https://www.goldencity.church/groups">Golden City Groups</a><span aria-hidden="true">/</span> Resource library</p>
      <h1 id="hero-heading">Resources for<br />life <span>together.</span></h1>
      <p class="hero-description">A little help for the way we gather, read Scripture, and follow Jesus. Find something for your next conversation—or your own quiet moment.</p>
      <a class="button" href="#library">Explore resources <Arrow /></a>
      <p class="hero-note">For your group. For your walk. For the week ahead.</p>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="art-ring"></div>
      <div class="art-caption"><span class="tiny-cross">+</span> ROOTED IN SCRIPTURE. SHARED IN COMMUNITY.</div>
      <div class="paper paper-back"><span>GOLDEN CITY · GROUPS</span><div>Life with<br />Jesus is<br />something<br />we share.</div></div>
      <div class="paper paper-front">
        <div class="paper-header"><img src="/groups-logo.png" alt="" width="1072" height="184" /><span>READING GUIDE</span></div>
        <div class="paper-rule"></div><p class="paper-label">A SIMPLE RHYTHM</p>
        <div class="paper-title">Open the Word.<br />Make room<br />to respond.</div>
        <div class="paper-steps"><span><b>S</b> Scripture</span><span><b>O</b> Observation</span><span><b>A</b> Application</span><span><b>P</b> Prayer</span></div>
        <div class="paper-footer">FOR THE EVERYDAY WORK OF FOLLOWING JESUS</div>
      </div>
      <span class="art-edition">GOLDEN CITY / RESOURCE COLLECTION</span>
    </div>
  </section>
  <section id="library" class="library wrap" aria-labelledby="library-heading">
    <div class="library-intro"><div><p class="eyebrow">Made for the moments that matter</p><h2 id="library-heading">Find a resource.</h2></div><p>Simple tools to help you prepare,<br class="desktop-break" /> participate, and put faith into practice.</p></div>
    {available.length > 0 ? <>
      <nav class="category-nav" aria-label="Resource categories"><span>EXPLORE BY</span>{available.map(category => <a href={`#${category.id}`}>{category.title}<span aria-hidden="true">↘</span></a>)}</nav>
      {available.map((category, index) => <section class="category-section" id={category.id} aria-labelledby={`${category.id}-heading`}>
        <div class="category-heading"><div><span class="section-number" aria-hidden="true">0{index + 1}</span><h2 id={`${category.id}-heading`}>{category.title}</h2></div><p>{category.description}</p></div>
        <div class="resource-grid">{all.filter(resource => resource.category === category.id).map(resource => <ResourceCard resource={resource} />)}</div>
      </section>)}
    </> : <div class="empty-state"><h3>Good things are taking shape.</h3><p>Our resource collection is being prepared. In the meantime, find a group and keep growing together.</p><a class="text-link" href="https://www.goldencity.church/groups/fall2026">Find a Group <Arrow /></a></div>}
  </section>
  <section class="gather-invitation wrap" aria-labelledby="gather-heading"><div><p class="eyebrow">Put it into practice</p><h2 id="gather-heading">Better when we<br />grow together.</h2><p>Resources can start a conversation.<br />A group gives you people to share it with.</p></div><a class="button button-light" href="https://www.goldencity.church/groups/fall2026">Find your group <Arrow diagonal /></a><span class="invitation-mark" aria-hidden="true">+</span></section>
</Layout>
