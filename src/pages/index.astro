---
import Layout from '../layouts/Layout.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { categories } from '../lib/resource';
import { resources } from '../lib/resources';
const all = await resources;
---
<Layout>
  <section class="hero wrap" aria-labelledby="hero-heading">
    <p class="eyebrow breadcrumb"><a href="https://www.goldencity.church/groups">Golden City Groups</a><span aria-hidden="true">/</span> Resource library</p>
    <h1 id="hero-heading">Resources for life <span>together.</span></h1>
    <p class="hero-description">Find a resource for your next gathering. Choose a category below to explore.</p>
  </section>
  <section id="library" class="library wrap" aria-label="Resource categories">
    {categories.map((category, index) => {
      const items = all.filter(resource => resource.category === category.id);
      return <details class="category-section" id={category.id}>
        <summary class="category-heading">
          <span class="section-number" aria-hidden="true">0{index + 1}</span>
          <div class="category-copy"><h2>{category.title}</h2><p>{category.description}</p></div>
          <span class="category-count">{items.length} {items.length === 1 ? 'resource' : 'resources'}</span>
          <span class="category-toggle" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m6 9 6 6 6-6" /></svg></span>
        </summary>
        {items.length ? <div class="resource-grid">{items.map(resource => <ResourceCard resource={resource} />)}</div> : <p class="category-empty">Resources will be added here as they are ready.</p>}
      </details>;
    })}
  </section>
</Layout>
<script>
  function openLinkedCategory() {
    const category = document.getElementById(window.location.hash.slice(1));
    if (category instanceof HTMLDetailsElement) category.open = true;
  }
  openLinkedCategory();
  window.addEventListener('hashchange', openLinkedCategory);
</script>
