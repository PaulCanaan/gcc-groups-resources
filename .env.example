# demo: clearly labeled sample resources; sanity: published, cleared CMS content
CONTENT_SOURCE=demo
# Required when CONTENT_SOURCE=sanity. IDs are not secrets.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=
# Only needed for a private dataset. Build-time read permission only.
SANITY_READ_TOKEN=
# Set after the resource domain is confirmed. Local previews omit canonical URLs.
SITE_URL=
